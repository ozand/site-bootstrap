# No secrets are required for local development (Keystatic runs in 'local' storage mode).
#
# Private editor host only. Never commit real values or copy them into the
# public static build context. Switch keystatic.config.ts to:
#   storage: { kind: 'github', repo: { owner: '<owner>', name: '<repo>' } }
# Then provide these values through the private host environment:
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=
# PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
