---
import Layout from '@/layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} — __SITE_NAME__`} description={post.data.description}>
  <article class="prose mx-auto max-w-3xl">
    <h1 class="text-3xl font-bold tracking-tight">{post.data.title}</h1>
    {
      post.data.pubDate && (
        <time class="text-sm text-muted-foreground">
          {post.data.pubDate.toISOString().slice(0, 10)}
        </time>
      )
    }
    <div class="mt-8 space-y-4 leading-7">
      <Content />
    </div>
  </article>
</Layout>
